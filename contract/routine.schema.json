{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rtc/routine.schema.json",
  "title": "RTC Routine Definition",
  "description": "声明式时刻表：什么时候该响、什么时候该播报、什么时段不许主动打扰。不含任何运行时路径或平台命令。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timezone", "dateTypes", "alarmWindows", "rollcalls", "phases"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "这份时刻表的稳定身份。执行历史按它归档（history.db 的 routine_id）；省略时按 default 处理，建议填上——换文件、改名都不影响历史对齐"
    },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "timezone": {
      "type": "string",
      "description": "IANA 时区名，例如 {{TIMEZONE}}",
      "minLength": 1
    },
    "tzOffset": {
      "type": "string",
      "pattern": "^[+-][0-9]{2}:[0-9]{2}$",
      "description": "UTC 偏移，例如 {{TZ_OFFSET}}"
    },
    "dateTypes": {
      "type": "object",
      "description": "日期类型判定规则。holidayOverrides 优先级最高。",
      "additionalProperties": false,
      "required": ["workday", "weekend", "holidayOverrides"],
      "properties": {
        "workday": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "description": "星期几算工作日，0=周日" },
        "weekend": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 } },
        "holidayOverrides": {
          "type": "array",
          "description": "手工维护的覆盖表，不联网抓取（网络失败会造成静默）",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "type"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "type": { "enum": ["workday", "weekend", "holiday"] },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "alarmWindows": {
      "type": "array",
      "description": "需要重复响铃直到被确认的窗口。这是唯一描述『闹钟』的地方。",
      "items": { "$ref": "#/$defs/alarmWindow" }
    },
    "weekendAlarms": {
      "type": "boolean",
      "default": true,
      "description": "false = 周末不响闹钟（窗口集仍然存在，只是不生成）"
    },
    "holidayAlarms": {
      "type": "boolean",
      "default": true,
      "description": "false = 节假日不响闹钟"
    },
    "rollcalls": {
      "type": "array",
      "description": "例行播报（汇报/跟进/总结）。同一时点在不同日期类型可有不同语义，由 kindByDateType 决定。",
      "items": { "$ref": "#/$defs/rollcall" }
    },
    "phases": {
      "type": "array",
      "description": "一天内的相位，约束『能不能主动发消息』。",
      "items": { "$ref": "#/$defs/phase" }
    },
    "weeklyChores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dayOfWeek", "label"],
        "properties": {
          "dayOfWeek": { "type": "integer", "minimum": 0, "maximum": 6 },
          "label": { "type": "string" },
          "attachToRollcallHour": { "type": "integer", "minimum": 0, "maximum": 23 }
        }
      }
    }
  },
  "$defs": {
    "alarmWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "start", "end", "intervalMin", "expectFires", "ackHints"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string" },
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "本地时间 HH:MM" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "闭区间，含这一分钟" },
        "intervalMin": { "type": "integer", "minimum": 1 },
        "expectFires": { "type": "integer", "minimum": 1, "description": "(end-start)/intervalMin + 1，生成时校验" },
        "ackHints": { "type": "array", "items": { "type": "string" }, "description": "用户说这些词即视为确认" },
        "dateTypes": {
          "type": "array",
          "items": { "enum": ["workday", "weekend", "holiday"] },
          "description": "空/省略 = 每天都生效"
        },
        "oneOff": {
          "type": "boolean",
          "description": "true = 一次性提醒：只在 validFrom 当天存在，且只响一次。送达即完成（state=delivered），不需要确认。end 建议比 start 晚 10-15 分钟，用于容忍 cron 恰好错过 start 那一分钟"
        },
        "validFrom": {
          "type": "string",
          "format": "date",
          "description": "该窗口从哪一天开始生效（含）。省略 = 无限期"
        },
        "validUntil": {
          "type": "string",
          "format": "date",
          "description": "该窗口到哪一天失效（含）。省略 = 无限期。一次性提醒 = validFrom 与 validUntil 同日"
        },
        "checklist": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["label"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$",
                    "description": "稳定身份：改标签、调整顺序都不影响已勾记录。省略时按标签内容哈希生成"
                  },
                  "label": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "description": "该窗口要逐项打勾的清单。写字符串也行（等价于只要 label），但推荐写成 {id, label}：id 是跨日对齐用的稳定身份，改文案不会让「已经打过勾的那一项」重新变成没打"
        },
        "skipDates": {
          "type": "array",
          "items": { "type": "string", "format": "date" },
          "description": "这些日期不响这个窗口。给周期窗口用——推迟某一天时记在这里（否则周期窗口会继续每天响）"
        },
        "disabled": {
          "type": "boolean",
          "description": "true = 永久停用这个窗口：以后任何日期都不生成。用于「以后别提醒我了」与「这件事完成了」。省略 = 启用"
        },
        "dueDate": {
          "type": "string",
          "format": "date",
          "description": "截止日。给了就按倒计时提醒：文案自动带「距截止还有 N 天」，每天只提醒一次（expectFires 固定为 1），并从 validFrom 起每天重新提醒直到 dueDate 当天；次日（dueDate+1）再响一次复盘，之后永停。剩余天数由代码算，不由模型判断"
        },
        "canceled": {
          "type": "boolean",
          "description": "该倒计时已被取消。取消=整段停（含复盘日），代码写入；手工改它等于伪造取消，别这么干"
        },
        "format": {
          "enum": ["follow", "summary", "report", "report-fallback"],
          "description": "摘要/早报窗口类型：follow=跟进、summary=总结、report=早报（due 直接读 state/reports/<日期>.md，缺失时静态兜底）、report-fallback=早报兜底窗口（有 result=ok 回执则静默，否则有文件补发文件、没文件发静态）。report 与 report-fallback 不能同时启用"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "oneOff": { "const": true } }, "required": ["oneOff"] },
          "then": { "properties": { "expectFires": { "const": 1 } } }
        }
      ]
    },
    "rollcall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hour", "kindByDateType"],
      "properties": {
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "minute": { "type": "integer", "minimum": 0, "maximum": 59, "default": 0 },
        "kindByDateType": {
          "type": "object",
          "description": "键为日期类型；值 report / follow / summary / none",
          "additionalProperties": { "enum": ["report", "follow", "summary", "none"] }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "start", "end", "proactiveAllowed"],
      "properties": {
        "name": { "type": "string" },
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "proactiveAllowed": { "type": "boolean" },
        "exception": { "type": "string", "description": "例如仅 P0 例外" }
      }
    }
  }
}
